<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <receiver android:name=".LocalPhoneFindStopProbe" android:exported="false" />
        <receiver android:name=".LocalFaceCollectionProbe" android:exported="false" />
        <receiver android:name=".LocalWatchSettingsProbe" android:exported="false" />
    </application>
</manifest>
